# =========================================================
# RestaurantAI Runtime
# =========================================================

# Supported values:
# local  = Restaurant/local-server installation
# online = cloud/deployed installation
RESTAURANTAI_MODE=online

# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Browser client origins allowed to call this API. Use exact origins only.
CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# LAN mode: set HOST=0.0.0.0 and ALLOW_LAN_ORIGINS=true on the server PC.
# Allows private LAN browser origins on the ports below. Do not use "*" for CORS.
ALLOW_LAN_ORIGINS=false
LAN_CLIENT_PORTS=3000,5173,5174,5175,5500,5501,8080


# =========================================================
# Local PostgreSQL Configuration
# =========================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurantai
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# File uploads. Installed local mode defaults to C:\ProgramData\RestaurantAI\data\uploads.
UPLOAD_DIR=uploads

# Cloud-to-local order sync. Apply migration 016 on both databases first.
# Render needs the same dedicated secret; enable the worker ONLY in local mode.
# Use a randomly generated 32+ character secret, never a browser/VITE variable.
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_BASE_URL=https://restaurant-ai-4myq.onrender.com/api
CLOUD_SYNC_SECRET=
CLOUD_SYNC_INTERVAL_SECONDS=10

# Public customer ordering safeguards
PUBLIC_DAILY_ORDER_LIMIT=5
# Temporary public cloud-order testing only. Local-mode orders keep OTP required.
# Restore true after testing. This does not affect tracking or staff authentication.
PUBLIC_ORDER_OTP_REQUIRED=true
MAX_TOTAL_QUANTITY=100
OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=30
OTP_TOKEN_EXPIRY_MINUTES=20
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=3
OTP_SECRET=
# Independent checkout OTP delivery. Real provider credentials are required.
OTP_DELIVERY_CHANNEL=sms
SMS_PROVIDER=twilio
# Shared Twilio account credentials (SMS does not require WhatsApp credentials).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Supply an SMS sender OR a Messaging Service with an SMS-capable sender.
TWILIO_SMS_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp is optional. Disabled integrations ignore provider/credential settings.
WHATSAPP_ENABLED=false
# When enabled, choose meta or twilio. Existing deployments without the flag
# retain their configured WhatsApp provider. OTP_DELIVERY_CHANNEL=whatsapp opts in.
WHATSAPP_PROVIDER=
# Required when WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required when WHATSAPP_PROVIDER=twilio
TWILIO_WHATSAPP_NUMBER=
# Legacy placeholders; Twilio SMS uses the credentials/sender above instead.
SMS_API_KEY=
SMS_SENDER_ID=


# =========================================================
# Online PostgreSQL
# =========================================================

# Used only when RESTAURANTAI_MODE=online
DATABASE_URL=


# =========================================================
# Local Backup Configuration
# =========================================================

BACKUP_DIR=../backups/database
POSTGRES_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
