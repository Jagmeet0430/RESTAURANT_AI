# =========================================================
# RestaurantAI Runtime
# =========================================================

# Supported values:
# local  = Restaurant/local-server installation
# online = cloud/deployed installation
RESTAURANTAI_MODE=online

# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Browser client origins allowed to call this API. Use exact origins only.
CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# LAN mode: set HOST=0.0.0.0 and ALLOW_LAN_ORIGINS=true on the server PC.
# Allows private LAN browser origins on the ports below. Do not use "*" for CORS.
ALLOW_LAN_ORIGINS=false
LAN_CLIENT_PORTS=3000,5173,5174,5175,5500,5501,8080


# =========================================================
# Local PostgreSQL Configuration
# =========================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurantai
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# File uploads. Installed local mode defaults to C:\ProgramData\RestaurantAI\data\uploads.
UPLOAD_DIR=uploads


# =========================================================
# Online PostgreSQL
# =========================================================

# Used only when RESTAURANTAI_MODE=online
DATABASE_URL=


# =========================================================
# Local Backup Configuration
# =========================================================

BACKUP_DIR=../backups/database
POSTGRES_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
